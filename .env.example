# Copia este fichero a .env.local y rellena los valores. NUNCA subas claves al repositorio.
# Con `vercel env pull` se rellenan solos DATABASE_URL y VERCEL_OIDC_TOKEN.

# Base de datos Neon Postgres (creada desde Vercel Marketplace, plan gratuito)
DATABASE_URL=

# Secreto para firmar la sesión (mínimo 32 caracteres aleatorios)
SESSION_SECRET=

# --- Motor de IA (opcional; si no hay ninguno disponible los agentes usan el modo simulado) ---
# auto (por defecto) | gateway | anthropic | groq | simulado
AI_ENGINE=auto
# Vercel AI Gateway: en Vercel se autentica solo con el token OIDC del despliegue.
# AI_GATEWAY_API_KEY=
# Modelos en orden de preferencia (los de Anthropic requieren créditos de pago de AI Gateway):
# AI_GATEWAY_MODELS=anthropic/claude-opus-5.5,recursive/flint-v1.0,nvidia/nemotron-3.5-lightning-free
# API de Anthropic directa:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Groq (plan gratuito, sin tarjeta):
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Límite de peticiones por usuario y día
MAX_RUNS_PER_DAY=50
